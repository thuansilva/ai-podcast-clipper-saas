# ==============================================================================
# AI Podcast Clipper - Backend (.env)
# ==============================================================================
# Estas variáveis são usadas como Modal Secrets no deploy.
# Para dev local (se adaptar para FastAPI puro), copie para .env e preencha.
# ==============================================================================

# --- Autenticação do Endpoint -------------------------------------------------
# [OBRIGATÓRIO] Token Bearer que o frontend envia para autenticar chamadas
# Deve ser o MESMO valor de PROCESS_VIDEO_ENDPOINT_AUTH no frontend
AUTH_TOKEN=seu-auth-token-aqui

# --- Google Gemini (IA que identifica momentos virais) ------------------------
# [OBRIGATÓRIO] API Key do Google AI / Gemini
# Pegar em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# [OPCIONAL] Modelo do Gemini a usar (default: gemini-3.6-flash")
# GEMINI_MODEL=gemini-3.6-flash"

# --- AWS S3 (leitura/escrita dos vídeos) --------------------------------------
# [OBRIGATÓRIO] Mesmas credenciais usadas no frontend
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# --- LR-ASD (detecção de falante ativo) ---------------------------------------
# [OBRIGATÓRIO só pra local_server.py] Caminho do submódulo asd/ nesta máquina.
# No Modal (main.py), o container copia asd/ pra "/asd" na raiz do sistema
# (ver main.py:52), e por isso o default hardcoded em local_server.py também é
# "/asd" — que não existe fora do container Modal. Rodando local_server.py
# localmente, aponte para o caminho real do submódulo (ex. o que "pwd" devolve
# dentro de ai-podcast-clipper-backend/asd), senão o processamento falha com
# "[Errno 2] No such file or directory: '/asd'" assim que chega na etapa de
# detecção de falante ativo.
# ASD_DIR=/caminho/absoluto/para/ai-podcast-clipper-backend/asd
