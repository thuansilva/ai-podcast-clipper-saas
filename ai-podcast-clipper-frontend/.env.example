# ==============================================================================
# AI Podcast Clipper - Frontend
# Variáveis de Ambiente (Referência Completa)
# ==============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# Variáveis marcadas com [OBRIGATÓRIO] devem ser preenchidas.
# Variáveis marcadas com [OPCIONAL] têm default ou são opcionais.
# ==============================================================================

# --- App Geral ----------------------------------------------------------------

# [OBRIGATÓRIO] URL base da aplicação
BASE_URL="http://localhost:3000"

# [OPCIONAL] Define o ambiente (development | test | production). Default: development
NODE_ENV="development"

# [OPCIONAL] Ativa o modo dev do Inngest (background jobs locais)
INNGEST_DEV=1

# [OPCIONAL] Pular validação de variáveis de ambiente (útil para Docker builds)
# SKIP_ENV_VALIDATION=true

# --- Banco de Dados (PostgreSQL) ---------------------------------------------
# [OBRIGATÓRIO] Connection string do PostgreSQL
# Local via docker-compose: postgresql://postgres:postgres@localhost:5432/ai_podcast_clipper
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_podcast_clipper"

# --- Autenticação (Clerk) ----------------------------------------------------
# Pegar em: https://dashboard.clerk.com → API Keys

# [OBRIGATÓRIO] Chave pública do Clerk (visível no client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# [OBRIGATÓRIO] Chave secreta do Clerk (server-side)
CLERK_SECRET_KEY="sk_test_..."

# [OPCIONAL] Secret do webhook do Clerk para sync de usuários
# Pegar em: Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET="whsec_..."

# [OPCIONAL] Rotas de login/signup customizadas
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- AWS S3 (Storage de vídeos e clips) --------------------------------------
# [OBRIGATÓRIO] Credenciais IAM com permissão de leitura/escrita no bucket S3
# Pegar em: AWS Console → IAM → Users → Security Credentials
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"

# [OBRIGATÓRIO] Nome do bucket S3 onde os vídeos são armazenados
S3_BUCKET_NAME="ai-podcast-clipper"

# --- Processamento de Vídeo (Backend Modal / Python) -------------------------
# [OBRIGATÓRIO] URL do endpoint de processamento de vídeo
# - Modal deploy: https://seu-workspace--ai-podcast-clipper-aipodcastclipper-process-video.modal.run
# - Local dev: http://localhost:8000/process_video
PROCESS_VIDEO_ENDPOINT="http://localhost:8000/process_video"

# [OBRIGATÓRIO] Token Bearer que autentica chamadas ao backend Python
# Deve ser o MESMO valor de AUTH_TOKEN no backend
PROCESS_VIDEO_ENDPOINT_AUTH="dev_secret_token"

# [OPCIONAL] URL do endpoint de download do YouTube
# Se não definido, será derivado automaticamente do PROCESS_VIDEO_ENDPOINT
YOUTUBE_DOWNLOAD_ENDPOINT="http://localhost:8000/download_youtube"

# --- Stripe (Pagamentos) -----------------------------------------------------
# Pegar em: https://dashboard.stripe.com → API Keys (use test keys)

# [OBRIGATÓRIO] Chave pública do Stripe (visível no client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# [OBRIGATÓRIO] Chave secreta do Stripe (server-side)
STRIPE_SECRET_KEY="sk_test_..."

# [OBRIGATÓRIO] Secret do webhook do Stripe
# Local: rode `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# [OBRIGATÓRIO] Price IDs dos pacotes de créditos avulsos (one-time)
# Criar em: Stripe Dashboard → Products → Prices
STRIPE_SMALL_CREDIT_PACK="price_small_pack"
STRIPE_MEDIUM_CREDIT_PACK="price_medium_pack"
STRIPE_LARGE_CREDIT_PACK="price_large_pack"

# [OPCIONAL] Price IDs das assinaturas recorrentes (defaults fornecidos)
STRIPE_CREATOR_SUBSCRIPTION_PRICE_ID="price_creator_monthly"
STRIPE_PRO_STUDIO_SUBSCRIPTION_PRICE_ID="price_pro_studio_monthly"

# --- Inngest (Background Jobs) -----------------------------------------------
# [OPCIONAL] Event key do Inngest (apenas para envio externo de eventos)
# Em dev local com `npx inngest-cli@latest dev`, não é necessário
# INNGEST_EVENT_KEY=...
