# -----------------------------------------------------------------------------
# AI PODCAST CLIPPER - VARIÁVEIS DE AMBIENTE (LOCAL / DESENVOLVIMENTO)
# -----------------------------------------------------------------------------

# Autenticação Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Servidor Local / Inngest
BASE_URL="http://localhost:3000"
INNGEST_DEV=1

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_podcast_clipper"

# AWS S3 Storage
AWS_ACCESS_KEY_ID="dummy_aws_access_key"
AWS_SECRET_ACCESS_KEY="dummy_aws_secret_key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="ai-podcast-clipper-bucket"

# Modal GPU Worker (Backend Python)
PROCESS_VIDEO_ENDPOINT="http://localhost:8000/process_video"
PROCESS_VIDEO_ENDPOINT_AUTH="dev_modal_secret_token"
YOUTUBE_DOWNLOAD_ENDPOINT="http://localhost:8000/download_youtube"

# Stripe Pagamentos & Webhooks
STRIPE_SECRET_KEY="sk_test_dummy_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_test_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_dummy_publishable_key"
STRIPE_SMALL_CREDIT_PACK="price_small_pack"
STRIPE_MEDIUM_CREDIT_PACK="price_medium_pack"
STRIPE_LARGE_CREDIT_PACK="price_large_pack"
